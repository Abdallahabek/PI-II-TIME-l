PORT=3000

# OBRIGATORIO: chave secreta para assinatura HMAC dos tokens (sem valor padrao no codigo)
# Defina uma chave longa e aleatoria antes de iniciar o servidor
AUTH_SECRET=defina-uma-chave-secreta-forte-com-pelo-menos-32-caracteres

# OPCIONAL: origens permitidas no CORS separadas por virgula (vazio permite origens locais/dev)
# Exemplo: CORS_ORIGIN=http://localhost:5500,http://127.0.0.1:5500
CORS_ORIGIN=

# Configuracao do banco Oracle (Thin mode)
ORACLE_USER=seu_usuario
ORACLE_PASSWORD=sua_senha
ORACLE_CONNECTION_STRING=localhost:1521/FREEPDB1
