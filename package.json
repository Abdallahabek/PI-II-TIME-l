{
  "name": "pi-ii-time-1",
  "version": "1.0.0",
  "description": "Sistema de Acompanhamento de Demandas de Desenvolvimento",
  "main": "dist/server.js",
  "scripts": {
    "start": "node dist/server.js",
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "build": "tsc",
    "db:init": "ts-node src/scripts/initDb.ts",
    "swagger": "ts-node src/openapi.ts",
    "test": "node -r ts-node/register --test tests/api.test.ts",
    "start:com-testes": "npm test && npm run build && npm start",
    "start:sem-testes": "npm run build && npm start"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^18.0.10",
    "express": "^4.21.0",
    "oracledb": "^26.0.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/node": "^22.5.5",
    "@types/oracledb": "^26.0.1",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.6.2"
  }
}
